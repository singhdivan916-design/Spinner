{
  "version": 2,
  "builds": [
    { "src": "spin.py",  "use": "@vercel/python" },
    { "src": "guest.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/spin",          "dest": "spin.py"  },
    { "src": "/spin",              "dest": "spin.py"  },
    { "src": "/health",            "dest": "spin.py"  },
    { "src": "/api/health",        "dest": "spin.py"  },
    { "src": "/test-telegram",     "dest": "spin.py"  },
    { "src": "/api/test-telegram", "dest": "spin.py"  },
    { "src": "/guest",             "dest": "guest.py" },
    { "src": "/api/guest",         "dest": "guest.py" }
  ]
}
